{
  "annotations": {
    "list": []
  },
  "description": "Metrics are scoped to individual scraped Pods; gauges may reset or be absent. No per-client labels. Gateway and profile filters require PodMonitor relabelings configured by the chart.",
  "editable": true,
  "id": null,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "ratatoskr_gateway_upstream_healthy{namespace=~\"$namespace\",gateway=~\"$gateway\",pod=~\"$pod\"}",
          "refId": "A"
        }
      ],
      "title": "Upstream healthy",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Shown only when bounded conntrack sampling is available and marked valid; missing series is unknown, not zero traffic.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "ratatoskr_gateway_forwarded_connections{namespace=~\"$namespace\",gateway=~\"$gateway\",pod=~\"$pod\",protocol=\"TCP\"}",
          "refId": "A"
        }
      ],
      "title": "Active forwarded TCP connections",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Shown only when bounded conntrack sampling is available and marked valid; missing series is unknown, not zero traffic.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "ratatoskr_gateway_forwarded_connections{namespace=~\"$namespace\",gateway=~\"$gateway\",pod=~\"$pod\",protocol=\"UDP\"}",
          "refId": "A"
        }
      ],
      "title": "Active forwarded UDP connections",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Shown only when bounded conntrack sampling is available and marked valid; missing series is unknown, not zero traffic.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "ratatoskr_gateway_forwarded_connections_sample_ok{namespace=~\"$namespace\",gateway=~\"$gateway\",pod=~\"$pod\"}",
          "refId": "A"
        }
      ],
      "title": "Forwarded connection sample valid",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "id": 5,
      "targets": [
        {
          "expr": "ratatoskr_gateway_link_receive_bytes{namespace=~\"$namespace\",gateway=~\"$gateway\",pod=~\"$pod\"}",
          "refId": "A"
        }
      ],
      "title": "Gateway link bytes received (resettable gauge)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "id": 6,
      "targets": [
        {
          "expr": "ratatoskr_gateway_link_transmit_bytes{namespace=~\"$namespace\",gateway=~\"$gateway\",pod=~\"$pod\"}",
          "refId": "A"
        }
      ],
      "title": "Gateway link bytes transmitted (resettable gauge)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "id": 7,
      "targets": [
        {
          "expr": "sum by (namespace,gateway,pod) (increase(ratatoskr_gateway_programming_errors_total{namespace=~\"$namespace\",gateway=~\"$gateway\",pod=~\"$pod\"}[5m]))",
          "refId": "A"
        }
      ],
      "title": "Gateway datapath errors / 5m",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "id": 8,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,namespace,gateway,pod) (rate(ratatoskr_gateway_programming_duration_seconds_bucket{namespace=~\"$namespace\",gateway=~\"$gateway\",pod=~\"$pod\"}[5m])))",
          "refId": "A"
        }
      ],
      "title": "Gateway programming p95 (seconds)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "id": 9,
      "targets": [
        {
          "expr": "ratatoskr_gateway_wireguard_installed_peers{namespace=~\"$namespace\",gateway=~\"$gateway\",pod=~\"$pod\"}",
          "refId": "A"
        }
      ],
      "title": "Installed WireGuard peers (not healthy-peer count)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "id": 10,
      "targets": [
        {
          "expr": "ratatoskr_gateway_wireguard_handshaken_peers{namespace=~\"$namespace\",gateway=~\"$gateway\",pod=~\"$pod\"}",
          "refId": "A"
        }
      ],
      "title": "Peers with a recorded handshake (not current health)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "id": 11,
      "targets": [
        {
          "expr": "sum by (namespace,pod) (increase(ratatoskr_agent_programming_errors_total{namespace=~\"$namespace\",pod=~\"$pod\"}[5m]))",
          "refId": "A"
        }
      ],
      "title": "Agent programming errors / 5m",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "id": 12,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,namespace,pod) (rate(ratatoskr_agent_programming_duration_seconds_bucket{namespace=~\"$namespace\",pod=~\"$pod\"}[5m])))",
          "refId": "A"
        }
      ],
      "title": "Agent programming p95 (seconds)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Table-format instant latitude/longitude series are inner-joined by composite namespace/gateway/pod/provider/exit_ip; pins represent provider estimates only. Requires lookup_success=1 and last success <=300s. Check transformed table columns and provider terms in your Grafana version before treating pins as validated.",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "id": 13,
      "options": {
        "basemap": {
          "name": "OpenStreetMap",
          "type": "osm-standard"
        },
        "controls": {
          "mouseWheelZoom": true,
          "showZoom": true
        },
        "layers": [
          {
            "config": {
              "style": {
                "color": {
                  "fixed": "#5794F2"
                },
                "size": {
                  "fixed": 9
                }
              }
            },
            "location": {
              "latitude": "latitude",
              "longitude": "longitude",
              "mode": "coords"
            },
            "name": "Provider estimates",
            "tooltip": true,
            "type": "markers"
          }
        ],
        "view": {
          "id": "coords",
          "lat": 20,
          "lon": 0,
          "zoom": 2
        }
      },
      "targets": [
        {
          "expr": "label_join((ratatoskr_gateway_geolocation_latitude_degrees{namespace=~\"$namespace\",gateway=~\"$gateway\",pod=~\"$pod\"} and on(namespace,gateway,pod,provider,exit_ip) ratatoskr_gateway_geolocation_lookup_success{namespace=~\"$namespace\",gateway=~\"$gateway\",pod=~\"$pod\"} == 1 and on(namespace,gateway,pod,provider,exit_ip) (time() - ratatoskr_gateway_geolocation_last_success_timestamp_seconds{namespace=~\"$namespace\",gateway=~\"$gateway\",pod=~\"$pod\"}) <= 300), \"geo_point\", \"/\", \"namespace\", \"gateway\", \"pod\", \"provider\", \"exit_ip\")",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "label_join((ratatoskr_gateway_geolocation_longitude_degrees{namespace=~\"$namespace\",gateway=~\"$gateway\",pod=~\"$pod\"} and on(namespace,gateway,pod,provider,exit_ip) ratatoskr_gateway_geolocation_lookup_success{namespace=~\"$namespace\",gateway=~\"$gateway\",pod=~\"$pod\"} == 1 and on(namespace,gateway,pod,provider,exit_ip) (time() - ratatoskr_gateway_geolocation_last_success_timestamp_seconds{namespace=~\"$namespace\",gateway=~\"$gateway\",pod=~\"$pod\"}) <= 300), \"geo_point\", \"/\", \"namespace\", \"gateway\", \"pod\", \"provider\", \"exit_ip\")",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "title": "Exit geolocation (provider estimates)",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "geo_point",
            "mode": "inner"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "geo_point": true
            },
            "renameByName": {
              "Value #A": "latitude",
              "Value #B": "longitude"
            }
          }
        }
      ],
      "type": "geomap"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Compare reported country/city per provider and a shared exit_ip; absent samples mean unknown. Country/city are bounded provider output, not identity proof.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "id": 14,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "ratatoskr_gateway_geolocation_info{namespace=~\"$namespace\",gateway=~\"$gateway\",pod=~\"$pod\"} and on(namespace,gateway,pod,provider) ratatoskr_gateway_geolocation_sample_ok{namespace=~\"$namespace\",gateway=~\"$gateway\",pod=~\"$pod\"} == 1",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Provider agreement and current exit identity",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Pairwise provider distance is not proof of GPS truth; absent pair may mean one or both providers failed.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 58
      },
      "id": 15,
      "targets": [
        {
          "expr": "ratatoskr_gateway_geolocation_distance_meters{namespace=~\"$namespace\",gateway=~\"$gateway\",pod=~\"$pod\"}",
          "legendFormat": "{{provider_a}} \u2194 {{provider_b}} ({{exit_ip}})",
          "refId": "A"
        }
      ],
      "title": "Provider location disagreement (meters)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "ratatoskr",
    "egress"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "includeAll": true,
        "multi": true,
        "name": "namespace",
        "options": [],
        "query": {
          "query": "label_values(ratatoskr_gateway_upstream_healthy, namespace)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "includeAll": true,
        "multi": true,
        "name": "gateway",
        "options": [],
        "query": {
          "query": "label_values(ratatoskr_gateway_upstream_healthy{namespace=~\"$namespace\"}, gateway)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "includeAll": true,
        "multi": true,
        "name": "pod",
        "options": [],
        "query": {
          "query": "label_values(ratatoskr_gateway_upstream_healthy{namespace=~\"$namespace\",gateway=~\"$gateway\"}, pod)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Ratatoskr Egress Gateways",
  "uid": "ratatoskr-egress",
  "version": 1
}

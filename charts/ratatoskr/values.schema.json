{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ratatoskr Helm values",
  "type": "object",
  "properties": {
    "driver": {"type": "string", "enum": ["init", "agent"]},
    "datapath": {"type": "string", "enum": ["iproute", "ebpf"]},
    "operatorNamespace": {"type": "string"},
    "clusterDomain": {"type": "string", "minLength": 1},
    "image": {
      "type": "object",
      "properties": {
        "registry": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "agent": {
      "type": "object",
      "properties": {
        "healthPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "criSocket": {"type": "string", "pattern": "^/.+"},
        "resources": {"type": "object"}
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "replicas": {"type": "integer", "minimum": 1},
        "leaderElection": {
          "type": "object",
          "properties": {"enabled": {"type": "boolean"}}
        },
        "resources": {"type": "object"}
      }
    },
    "webhook": {
      "type": "object",
      "properties": {
        "replicas": {"type": "integer", "minimum": 1},
        "resources": {"type": "object"}
      }
    },
    "dns": {
      "type": "object",
      "properties": {
        "clusterIP": {"type": "string", "maxLength": 45},
        "upstreamIP": {"type": "string"},
        "upstreamProbeURL": {"type": "string", "maxLength": 2048}
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "geolocation": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "interval": {"type": "string", "pattern": "^[1-9][0-9]*[smh]$"}
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "namespaceSelector": {"type": "object"},
            "podSelector": {"type": "object"}
          }
        },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {"oneOf": [{"type": "boolean"}, {"type": "string", "enum": ["auto"]}]},
            "labels": {"type": "object"},
            "interval": {"type": "string", "pattern": "^[1-9][0-9]*[smh]$"},
            "scrapeTimeout": {"type": "string", "pattern": "^[1-9][0-9]*[smh]$"}
          }
        },
        "podMonitor": {
          "type": "object",
          "properties": {
            "enabled": {"oneOf": [{"type": "boolean"}, {"type": "string", "enum": ["auto"]}]},
            "labels": {"type": "object"},
            "namespaceSelector": {"type": "object"},
            "interval": {"type": "string", "pattern": "^[1-9][0-9]*[smh]$"},
            "scrapeTimeout": {"type": "string", "pattern": "^[1-9][0-9]*[smh]$"}
          }
        },
        "dashboard": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "sidecarLabel": {"type": "string", "minLength": 1},
            "sidecarValue": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {"enabled": {"type": "boolean"}}
    },
    "exclusions": {
      "type": "object",
      "properties": {
        "serviceCIDRs": {"type": "array", "items": {"type": "string"}},
        "podCIDRs": {"type": "array", "items": {"type": "string"}},
        "extraCIDRs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}

# --- Secrets: never commit VPN configs, credentials, keys or tokens ---
*.ovpn
*.conf.secret
auth.txt
login.conf
*.key
*.pem
*.p12
*.pfx
*.crt
!charts/**/testdata/*.crt
wg*.conf
*.secret
*.token
.env
.env.*
secrets/
**/secret-*.yaml

# --- Build output ---
/bin/
/dist/
*.o
cover.out
coverage.html

# --- Generated eBPF objects (regenerated by `make generate`) ---
pkg/datapath/ebpf/*_bpfel.o
pkg/datapath/ebpf/*_bpfeb.o

# --- Test artifacts (live reports are regenerated each run) ---
test/e2e/live/report.json
test/e2e/live/report.md
test/e2e/**/artifacts/
*.pcap

# --- Tooling ---
/.cache/
/.tools/
.vscode/
.idea/
*.swp
kubeconfig*

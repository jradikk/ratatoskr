apiVersion: v1
kind: ConfigMap
metadata:
  name: gateway-config
  namespace: @NAMESPACE@
data:
  gateway.json: |
    {"gatewayID":7,"clients":["@CLIENT_IP@"],"mtu":1400,"encryption":"none"}
---
apiVersion: v1
kind: Pod
metadata:
  name: gateway
  namespace: @NAMESPACE@
spec:
  automountServiceAccountToken: false
  nodeName: @GATEWAY_NODE@
  terminationGracePeriodSeconds: 5
  containers:
    - name: gateway
      image: @GATEWAY_IMAGE@
      imagePullPolicy: Never
      command: [/ratatoskr]
      args: [-config, /config/gateway.json]
      env:
        - name: DATAPATH
          value: ebpf
        - name: POD_IP
          valueFrom:
            fieldRef:
              fieldPath: status.podIP
        - name: POD_UID
          valueFrom:
            fieldRef:
              fieldPath: metadata.uid
      securityContext:
        runAsUser: 0
        capabilities:
          drop: [ALL]
          add: [NET_ADMIN, BPF, PERFMON]
      volumeMounts:
        - name: config
          mountPath: /config
          readOnly: true
      readinessProbe:
        httpGet:
          port: 9900
          path: /healthz
        periodSeconds: 2
        timeoutSeconds: 2
        failureThreshold: 1
    - name: upstream
      image: @FAKE_IMAGE@
      imagePullPolicy: Never
      command: [/fakeupstream]
      args: [-role, upstream, -local, $(POD_IP), -remote, @REMOTE_IP@]
      env:
        - name: POD_IP
          valueFrom:
            fieldRef:
              fieldPath: status.podIP
      securityContext:
        runAsUser: 0
        capabilities:
          drop: [ALL]
          add: [NET_ADMIN]
    - name: observer
      image: @TOOLS_IMAGE@
      imagePullPolicy: Never
      command: [sleep, infinity]
      securityContext:
        runAsUser: 0
        capabilities:
          drop: [ALL]
  volumes:
    - name: config
      configMap:
        name: gateway-config
